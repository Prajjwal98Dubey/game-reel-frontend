# API base URL. Leave unset in development to use http://<metro-host>:3000 (the mock API or a local backend).
EXPO_PUBLIC_API_URL=
# PostHog project key. Leave empty to disable PostHog (events still go to POST /v1/events).
EXPO_PUBLIC_POSTHOG_KEY=
# development | staging | production
EXPO_PUBLIC_ENV=development
