{
  "cli": { "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ENV": "development" }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": { "EXPO_PUBLIC_ENV": "staging" }
    },
    "production": {
      "channel": "production",
      "env": { "EXPO_PUBLIC_ENV": "production" }
    }
  }
}
